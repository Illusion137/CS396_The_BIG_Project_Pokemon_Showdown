{
    "lib": ["ESNext"],
    "exclude": ["node_modules", "lib-origin"],
    "compilerOptions": {
        "types": ["node"],
        "jsx": "react-native",
        "strict": true,
        "noImplicitAny": false,
        "noEmitOnError": true,
        "noEmit": true,
        "esModuleInterop": true,
        "target": "esnext",
        "module": "commonjs",
        "resolveJsonModule": true,
        "sourceMap": true,
        "outDir": "dist",
        "noUnusedLocals": false,
        "noUnusedParameters": true,
        "allowUnreachableCode": false,
        "alwaysStrict": true,
        "noFallthroughCasesInSwitch": true,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "baseUrl": ".",
        "paths": {
            "@native/*": ["./lib-origin/roze/native/*"],
            "@lib/*": ["./lib-origin/roze/lib/*"],
            "@roze/*": ["./lib-origin/roze/src/*", "./lib-origin/roze/*"],
            "@arneb/*": ["./lib-origin/arneb/*"],
            "@origin/*": ["./lib-origin/origin/src/*"],
            "@lutz/*": ["./lib-origin/lutz/src/*"],
            "@sosu/*": ["./lib-origin/sosu/src/*"],
            "@illusive/*": ["./lib-origin/Illusive/src/*"],
            "@illusicord/*": ["./lib-origin/illusicord/src/*"],
            "@common/*": ["./lib-origin/common/*"],
            "@admin/*": ["./lib-origin/admin/*"],
            "@sample/*": ["./lib-origin/sample/*"],
            "react-native-shumil": ["./node_modules/react-native-shumil/src/index.ts"],
            "googlevideo/sabr-stream": ["./node_modules/googlevideo/dist/src/exports/sabr-stream.js"],
            "googlevideo/utils": ["./node_modules/googlevideo/dist/src/exports/utils.js"],
            "googlevideo/protos": ["./node_modules/googlevideo/dist/src/exports/protos.js"],
        },
    },
}